---
import GuidePage from '@/components/pages/GuidePage.astro';
import HistoryPage from '@/components/pages/HistoryPage.astro';
import TextPage from '@/components/pages/TextPage.astro';
import { getTextPagePaths } from '@/lib/content';

export const getStaticPaths = getTextPagePaths;

const page = Astro.props;
---

{page.kind === 'history' && <HistoryPage locale="lv" slug={page.slug} />}
{page.kind === 'guide' && <GuidePage locale="lv" slug={page.slug} />}
{page.kind === 'text' && <TextPage locale="lv" slug={page.slug} />}
