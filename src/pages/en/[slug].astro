---
import HistoryPage from '@/components/pages/HistoryPage.astro';
import TextPage from '@/components/pages/TextPage.astro';
import { getTextPageSlugs } from '@/lib/content';

export async function getStaticPaths() {
  return (await getTextPageSlugs()).map((slug) => ({ params: { slug } }));
}

const { slug } = Astro.params;
---

{slug === 'pk-vesture' || slug === 'vesture' ? (
  <HistoryPage locale="en" slug={slug} />
) : (
  <TextPage locale="en" slug={slug} />
)}
