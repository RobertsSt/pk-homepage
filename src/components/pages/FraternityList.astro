---
import PageHeader from '@/components/PageHeader.astro';
import { Shield } from '@/components/Shield';
import type { Locale } from '@/i18n/config';
import { useTranslations } from '@/i18n/ui';
import Layout from '@/layouts/Layout.astro';
import { FRATERNITIES_SLUG, fraternityUrl, shieldTransitionName } from '@/lib/routes';
import { getFraternities } from '@/lib/site';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);

const all = await getFraternities();
const groups = [
  { heading: undefined, items: all.filter((f) => f.data.membership === 'pk') },
  { heading: t('list.outside'), items: all.filter((f) => f.data.membership === 'outside') },
];
const intro = t('list.intro', { count: groups[0]!.items.length });
---

<Layout locale={locale} path={FRATERNITIES_SLUG} title={t('fraternities.title')} description={intro}>
  <PageHeader title={t('fraternities.title')} kicker={t('site.name')}>
    <p class="text-ink-soft mt-8 max-w-2xl text-lg leading-relaxed" data-reveal>
      {intro}
    </p>
  </PageHeader>

  <div class="shell pb-24 lg:pb-36">
    {groups.map((group) => (
      <>
        {group.heading && (
          <h2 class="font-display mt-20 mb-8 text-[2rem] leading-tight" data-reveal>
            {group.heading}
          </h2>
        )}
        <ol class="border-rule border-t">
          {group.items.map((fraternity, index) => (
            <li data-reveal style={`--reveal-order:${index % 6}`}>
              <a
                href={fraternityUrl(locale, fraternity.id)}
                class="group border-rule hover:bg-paper-deep/60 grid grid-cols-[1.75rem_3rem_minmax(0,1fr)_1.25rem] items-center gap-x-4 border-b py-5 transition-colors sm:px-3 lg:grid-cols-[3rem_4.5rem_minmax(0,1.2fr)_minmax(0,1fr)_5rem_1.5rem] lg:gap-x-8"
              >
                <span class="text-ink-soft text-[0.72rem] font-semibold tracking-[0.18em] tabular-nums">
                  {String(index + 1).padStart(2, '0')}
                </span>
                <Shield
                  colors={fraternity.data.colors}
                  band={fraternity.data.band}
                  className="text-ink/65 h-12 w-auto transition-transform duration-500 ease-out group-hover:scale-110 group-hover:-rotate-3 lg:h-16"
                  style={{ viewTransitionName: shieldTransitionName(fraternity.id) }}
                />
                <span>
                  <span class="font-display block text-[1.45rem] leading-tight lg:text-[2rem]">
                    {fraternity.data.name}
                  </span>
                  <span class="font-display text-ink-soft mt-1 block text-[1.05rem] leading-snug italic lg:hidden">
                    {fraternity.data.mottos[0]}
                  </span>
                </span>
                <span class="font-display text-ink-soft hidden text-[1.2rem] leading-snug italic lg:block">
                  {fraternity.data.mottos[0]}
                </span>
                <span class="text-ink-soft hidden text-sm tabular-nums lg:block">
                  {fraternity.data.founded.getUTCFullYear()}
                </span>
                <span
                  class="text-xl transition-transform duration-300 group-hover:translate-x-1"
                  aria-hidden="true"
                >
                  →
                </span>
              </a>
            </li>
          ))}
        </ol>
      </>
    ))}
  </div>
</Layout>
