---
import { Image } from 'astro:assets';
import PageHeader from '@/components/PageHeader.astro';
import { Shield } from '@/components/Shield';
import type { Locale } from '@/i18n/config';
import { useTranslations } from '@/i18n/ui';
import Layout from '@/layouts/Layout.astro';
import { displayHost } from '@/lib/format';
import { FRATERNITIES_SLUG, fraternityUrl, shieldTransitionName } from '@/lib/routes';
import { getFraternities } from '@/lib/site';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);

const all = await getFraternities();
const groups = [
  { heading: undefined, items: all.filter((f) => f.data.membership === 'pk') },
  { heading: t('list.outside'), items: all.filter((f) => f.data.membership === 'outside') },
];
const intro = t('list.intro', { count: groups[0]!.items.length });

const emblems = ['arms', 'zirkel', 'cap', 'star'] as const;
const newTab = t('a11y.newTab');
---

<Layout locale={locale} path={FRATERNITIES_SLUG} title={t('fraternities.title')} description={intro}>
  <PageHeader title={t('fraternities.title')} kicker={t('site.name')}>
    <p class="text-ink-soft mt-8 max-w-2xl text-lg leading-relaxed" data-enter style="--reveal-order:3">
      {intro}
    </p>
  </PageHeader>

  <div class="shell pb-24 lg:pb-36">
    {groups.map((group) => (
      <>
        {group.heading && (
          <h2 class="font-display mt-20 mb-8 text-[2rem] leading-tight" data-reveal>
            {group.heading}
          </h2>
        )}
        <ol class="border-rule border-t">
          {group.items.map(({ id, data }, index) => (
            // The whole row leads to the fraternity's page: its name is the link, stretched over the
            // row and lifted above the insignia, which would otherwise lie on top of it (their blend
            // mode gives them a layer of their own). The contacts are links themselves and lie above
            // the stretched link. The row is the sheet the insignia are mixed into.
            <li
              class="group sheet border-rule relative grid grid-cols-[3rem_minmax(0,1fr)_1.25rem] items-center gap-x-4 gap-y-5 border-b py-6 transition-colors hover:[--tint:60%] sm:px-3 lg:grid-cols-[3rem_4.5rem_minmax(0,1.1fr)_auto_minmax(0,0.85fr)_1.5rem] lg:gap-x-8"
              data-reveal
              style={`--reveal-order:${index % 6}`}
            >
              <p class="text-ink-soft col-span-3 flex gap-3 text-[0.72rem] font-semibold tracking-[0.18em] tabular-nums lg:col-span-1 lg:flex-col lg:gap-1.5">
                <span>{String(index + 1).padStart(2, '0')}</span>
                <span class="font-normal tracking-[0.08em]">
                  {t('fraternities.founded', { year: data.founded.getUTCFullYear() })}
                </span>
              </p>
              <Shield
                colors={data.colors}
                band={data.band}
                className="text-ink/65 h-12 w-auto transition-transform duration-500 ease-out group-hover:scale-110 group-hover:-rotate-3 lg:h-16"
                style={{ viewTransitionName: shieldTransitionName(id) }}
              />
              <div>
                <a
                  href={fraternityUrl(locale, id)}
                  class="font-display block text-[1.45rem] leading-tight after:absolute after:inset-0 after:z-1 lg:text-[2rem]"
                >
                  {data.name}
                </a>
                <ul class="font-display text-ink-soft mt-1.5 text-[1.05rem] leading-snug italic">
                  {data.mottos.map((motto) => (
                    <li>{motto}</li>
                  ))}
                </ul>
              </div>
              <span
                class="text-xl transition-transform duration-300 group-hover:translate-x-1 lg:order-last"
                aria-hidden="true"
              >
                →
              </span>
              <ul
                class="col-span-3 flex items-center gap-3 lg:col-span-1"
                aria-label={`${data.name}: ${t('fraternity.insignia').toLowerCase()}`}
              >
                {emblems.map((key) => (
                  <li class="grid size-14 flex-none place-items-center lg:size-[4.5rem]">
                    <Image
                      src={data.heraldry[key]}
                      alt={t(`heraldry.${key}`)}
                      height={144}
                      class="on-paper h-auto max-h-14 w-auto max-w-full lg:max-h-[4.5rem]"
                    />
                  </li>
                ))}
              </ul>
              {/* Lines 24px high: the least a finger needs to hit one link and not the next. */}
              <address class="text-ink-soft relative z-10 col-span-3 text-sm leading-6 not-italic lg:col-span-1">
                {data.address && <span class="block">{data.address}</span>}
                {data.phone && (
                  <a class="hover:text-ink block w-fit" href={`tel:${data.phone}`}>
                    {data.phone}
                  </a>
                )}
                {data.email && (
                  <a class="hover:text-ink block w-fit break-all" href={`mailto:${data.email}`}>
                    {data.email}
                  </a>
                )}
                {data.website && (
                  <a
                    class="text-ink hover:text-accent block w-fit"
                    href={data.website}
                    target="_blank"
                    rel="noreferrer"
                  >
                    {displayHost(data.website)} <span aria-hidden="true">↗</span>
                    <span class="sr-only"> ({newTab})</span>
                  </a>
                )}
              </address>
            </li>
          ))}
        </ol>
      </>
    ))}
  </div>
</Layout>
