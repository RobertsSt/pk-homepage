---
import { Image } from 'astro:assets';
import crest from '@/assets/site/crest-ink.png';
import ShieldRow from '@/components/ShieldRow.astro';
import type { Homepage } from '@/lib/site';

interface Props {
  page: Homepage;
}

const { page } = Astro.props;
const { t, locale } = page;

const [firstWord, ...otherWords] = page.name.split(' ');

// The lettering closes into a ring, so it ends on a separator. The last
// character is a non-breaking space because an ordinary trailing space is
// dropped, which would leave the separator touching the first letter.
const sealEnd = ' \u00b7\u00a0';
const copy = {
  lv: {
    seal: `Prezidiju Konvents · Latvijas studentu korporācijas · Rīga · 1919${sealEnd}`,
    crestAlt: 'P!K! vēsturiskā emblēma: karogu vēdeklis virs studenta deķeļa un ozollapu vainaga',
  },
  en: {
    seal: `Presidium Convent · Latvia’s student fraternities · Riga · 1919${sealEnd}`,
    crestAlt: 'Historic emblem of P!K!: a fan of flags above a student cap and a wreath of oak leaves',
  },
}[locale];
---

<section class="shell grid items-center gap-12 pt-12 pb-12 lg:grid-cols-12 lg:gap-6 lg:pt-16 lg:pb-16">
  <div class="lg:col-span-7">
    <p class="kicker" data-enter>
      {page.tagline}
    </p>
    <h1
      class="font-display mt-7 text-[clamp(3.6rem,11.5vw,10.5rem)] leading-[0.84] font-normal tracking-[-0.035em]"
      data-enter="lines"
    >
      <span class="line-mask">
        <span>{firstWord}</span>
      </span>{' '}
      <span class="line-mask" style="--line:1">
        <span>
          <em class="text-wine">{otherWords.join(' ')}</em>
        </span>
      </span>
    </h1>
    <p class="mt-9 max-w-xl text-[1.3rem] leading-relaxed" data-enter style="--reveal-order:4">
      {page.lead}
    </p>
    <p
      class="mt-9 flex flex-wrap gap-x-9 gap-y-3 text-[0.95rem] font-semibold"
      data-enter
      style="--reveal-order:6"
    >
      <a href="#korporacijas" class="link">
        {t('hero.fraternities')} <span aria-hidden="true">↓</span>
      </a>
      <a href="#kalendars" class="link">
        {t('hero.calendar')} <span aria-hidden="true">↓</span>
      </a>
    </p>
  </div>

  {/* No delay here: this is the largest thing on the first screen. */}
  <div class="lg:col-span-5" data-enter>
    <div class="relative mx-auto aspect-square w-full max-w-[34rem]">
      <div class="seal absolute inset-0" aria-hidden="true" data-seal>
        <svg viewBox="0 0 400 400" class="text-ink/55 h-full w-full">
          <defs>
            <path id="seal-path" d="M200 200m-181 0a181 181 0 1 1 362 0a181 181 0 1 1-362 0"></path>
          </defs>
          <circle cx="200" cy="200" r="197" fill="none" stroke="currentColor" stroke-width="0.6"></circle>
          <circle cx="200" cy="200" r="166" fill="none" stroke="currentColor" stroke-width="0.6"></circle>
          {/* The script below spaces the letters to close the ring exactly.
               The letter-spacing here is the starting point it corrects, and
               what a visitor without JavaScript sees. */}
          <text
            font-size="12.5"
            font-weight="600"
            fill="currentColor"
            letter-spacing="6.5"
            style="text-transform:uppercase"
            data-seal-text
          >
            <textPath href="#seal-path">{copy.seal}</textPath>
          </text>
        </svg>
      </div>
      <Image
        src={crest}
        alt={copy.crestAlt}
        width={800}
        widths={[360, 560, 800]}
        sizes="(min-width: 64rem) 26rem, 70vw"
        loading="eager"
        fetchpriority="high"
        class="absolute inset-[14%] h-[72%] w-[72%] object-contain"
      />
      {/* Anything that keeps moving needs a way to stop it. */}
      <button
        type="button"
        class="icon-button seal-toggle"
        aria-pressed="false"
        aria-label={t('hero.pauseSeal')}
        data-seal-toggle
      >
        <svg viewBox="0 0 10 10" class="seal-toggle-pause" aria-hidden="true">
          <path d="M1.5 1h2.5v8H1.5zM6 1h2.5v8H6z"></path>
        </svg>
        <svg viewBox="0 0 10 10" class="seal-toggle-play" aria-hidden="true">
          <path d="M2 .8l7 4.2-7 4.2z"></path>
        </svg>
      </button>
    </div>
  </div>
</section>

<div class="shell pb-20 lg:pb-24">
  <div class="border-rule border-t pt-12">
    <ShieldRow fraternities={page.members} locale={locale} label={t('fraternities.title')} />
  </div>
</div>

<script>
  /**
   * Spaces the seal's letters so the lettering closes exactly one turn of its
   * ring. Browsers disagree on `textLength` for text on a path (Safari ignores
   * it), so the spacing is measured: ring length minus the letters' own width,
   * shared out over the letters.
   */
  function fitSeal() {
    const text = document.querySelector<SVGTextElement>('[data-seal-text]');
    const ring = document.querySelector<SVGPathElement>('#seal-path');
    if (!text || !ring) return;

    text.style.letterSpacing = '0px';
    const lettersWidth = text.getComputedTextLength();
    const spacing = (ring.getTotalLength() - lettersWidth) / text.getNumberOfChars();
    text.style.letterSpacing = `${spacing}px`;
  }

  // Letter widths are only final once the web font has loaded.
  document.fonts.ready.then(fitSeal);

  /**
   * The button that stops the ring turning. The choice is kept for the next
   * visit, where the browser allows storing it.
   */
  const SEAL_PAUSED = 'pk-seal-paused';
  const seal = document.querySelector<HTMLElement>('[data-seal]');
  const toggle = document.querySelector<HTMLButtonElement>('[data-seal-toggle]');

  function setSealPaused(paused: boolean) {
    seal?.toggleAttribute('data-paused', paused);
    toggle?.setAttribute('aria-pressed', String(paused));
  }

  function storedChoice(): boolean {
    try {
      return localStorage.getItem(SEAL_PAUSED) === '1';
    } catch {
      return false;
    }
  }

  if (storedChoice()) setSealPaused(true);
  toggle?.addEventListener('click', () => {
    const paused = toggle.getAttribute('aria-pressed') !== 'true';
    setSealPaused(paused);
    try {
      localStorage.setItem(SEAL_PAUSED, paused ? '1' : '0');
    } catch {
      // Storage is blocked; the choice then lasts for this page only.
    }
  });
</script>
