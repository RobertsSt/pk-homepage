---
import { Image } from 'astro:assets';
import oldSelonija from '@/assets/fraternities/selonija/photo-3.jpg';
import EraExplorer from '@/components/history/EraExplorer.astro';
import SectionTitle from '@/components/SectionTitle.astro';
import { historyLabels, loadHistory } from '@/lib/history';
import { pageUrl } from '@/lib/routes';
import type { Homepage } from '@/lib/site';
import '@/styles/history.css';

interface Props {
  page: Homepage;
}
const { page } = Astro.props;
const { t, locale, members } = page;
const story = await loadHistory(locale, 'pk-vesture');
const labels = historyLabels[locale];
const milestones = [
  ...page.milestones,
  { year: t('history.today'), text: t('history.todayText', { count: members.length }) },
];
const eras = milestones.map((milestone) => {
  const chapter = story.chapters.find((chapter) => chapter.year === milestone.year);
  return {
    year: milestone.year,
    title: chapter?.title ?? milestone.year,
    text: milestone.text,
    href: `${pageUrl(locale, 'pk-vesture')}#${chapter?.id ?? story.chapters[0]!.id}`,
  };
});
---

<section id="vesture" class="on-ink history-home" aria-labelledby="home-history-title">
  <div class="shell">
    <div class="history-home-heading">
      <div>
        <p class="kicker" data-reveal>
          {t('history.kicker')}
        </p>
        <div id="home-history-title">
          <SectionTitle text={t('history.title')} />
        </div>
      </div>
      <div class="history-home-intro" data-reveal>
        <p>{page.historyTeaser}</p>
        <a href={pageUrl(locale, 'pk-vesture')}>
          {labels.discover} <span aria-hidden="true">↗</span>
        </a>
      </div>
    </div>
    <EraExplorer id="home-history" locale={locale} eras={eras} illustrated>
      <figure class="history-home-photo">
        <Image
          src={oldSelonija}
          alt={labels.photoAltPk}
          widths={[480, 720, 1100]}
          sizes="(min-width: 1024px) 45vw, 100vw"
        />
        <figcaption>{labels.photoHome}</figcaption>
      </figure>
    </EraExplorer>
  </div>
</section>
