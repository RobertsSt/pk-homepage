---
import italicFont from '@/assets/fonts/newsreader-italic-400.woff2?url';
import type { Locale } from '@/i18n/config';
import Layout from '@/layouts/Layout.astro';
import { loadHomepage } from '@/lib/site';
import About from './About.astro';
import CalendarSection from './CalendarSection.astro';
import Contact from './Contact.astro';
import Facts from './Facts.astro';
import Fraternities from './Fraternities.astro';
import Hero from './Hero.astro';
import History from './History.astro';
import Officers from './Officers.astro';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const page = await loadHomepage(locale);
---

<Layout locale={locale}>
  {/* Half of the headline is set in italic, so here that font is fetched early too. */}
  <link slot="head" rel="preload" as="font" type="font/woff2" href={italicFont} crossorigin />
  <Hero page={page} />
  <Facts page={page} />
  <About page={page} />
  <Officers page={page} />
  <CalendarSection page={page} />
  <Fraternities page={page} />
  <History page={page} />
  <Contact page={page} />
</Layout>
