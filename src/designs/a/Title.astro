---
/**
 * A section heading in the style of the reference sites: the closing words
 * are set in italic and picked out in gold. One-word titles stay plain.
 */
interface Props {
  text: string;
  class?: string;
}

const { text, class: className } = Astro.props;
const [first, ...rest] = text.split(' ');
---

<h2 class:list={['title', className]} data-reveal>
  {first}
  {rest.length > 0 && ' '}
  {rest.length > 0 && <em>{rest.join(' ')}</em>}
</h2>
