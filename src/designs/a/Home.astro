---
import { Image } from 'astro:assets';
import candles from '@/assets/site/candles.webp';
import crest from '@/assets/site/crest-ink.png';
import parade from '@/assets/site/hero-parade.webp';
import procession from '@/assets/site/procession.jpg';
import { Shield } from '@/components/Shield';
import type { Locale } from '@/i18n/config';
import { todayInRiga } from '@/lib/calendar/dates';
import { loadHomepage } from '@/lib/site';
import Layout from './Layout.astro';
import { MonthCalendar } from './MonthCalendar';
import Title from './Title.astro';

interface Props {
  locale: Locale;
  path: string;
}

const { locale, path } = Astro.props;
const page = await loadHomepage(locale);
const { t, members, outside, presiding } = page;

const [firstWord, ...otherWords] = page.name.split(' ');

const copy = {
  lv: {
    crestAlt: 'P!K! vēsturiskā emblēma: karogu vēdeklis virs studenta deķeļa un ozollapu vainaga',
    paradeAlt: 'Studenti krāsu deķeļos nes karogus pāri tiltam; fonā Vecrīgas torņi',
    scroll: 'Uz leju',
  },
  en: {
    crestAlt: 'Historic emblem of P!K!: a fan of flags above a student cap and a wreath of oak leaves',
    paradeAlt: 'Students in coloured caps carry flags across a bridge, with the towers of Old Riga behind',
    scroll: 'Scroll down',
  },
}[locale];

const foundedYear = (date: Date) => date.getUTCFullYear();
---

<Layout locale={locale} path={path}>
  <!-- Hero -->
  <section class="bg-night relative isolate flex min-h-svh items-center overflow-hidden text-white">
    <Image
      src={parade}
      alt={copy.paradeAlt}
      widths={[768, 1280, 1920, 2560]}
      sizes="100vw"
      loading="eager"
      fetchpriority="high"
      class="hero-photo absolute inset-0 -z-20 h-full w-full object-cover"
    />
    <div class="from-night/80 via-night/55 to-night absolute inset-0 -z-10 bg-linear-to-b"></div>

    <div class="shell w-full pt-32 pb-44 text-center">
      <p class="pill" data-reveal>
        {t('hero.since', { year: page.foundedYear })}
      </p>
      <p
        class="mt-8 text-[0.78rem] font-semibold tracking-[0.34em] text-white/75 uppercase"
        data-reveal
        style="--reveal-order:1"
      >
        {page.tagline}
      </p>
      <h1
        class="font-display mt-5 text-[clamp(3rem,9.5vw,7.75rem)] leading-[1.02] font-medium tracking-[-0.01em]"
        data-reveal
        style="--reveal-order:2"
      >
        {firstWord} <em class="text-gold font-medium">{otherWords.join(' ')}</em>
      </h1>
      <p
        class="mx-auto mt-7 max-w-2xl text-lg leading-relaxed text-white/80"
        data-reveal
        style="--reveal-order:3"
      >
        {page.lead}
      </p>
      <p class="mt-10 flex flex-wrap justify-center gap-4" data-reveal style="--reveal-order:4">
        <a href="#korporacijas" class="btn btn-gold">
          {t('hero.fraternities')}
        </a>
        <a href="#kalendars" class="btn btn-ghost">
          {t('hero.calendar')}
        </a>
      </p>
    </div>

    <a
      href="#fakti"
      class="scroll-cue absolute bottom-28 left-1/2 -ml-3 hidden text-white/80 sm:block"
      aria-label={copy.scroll}
    >
      <svg viewBox="0 0 24 36" class="h-9 w-6" aria-hidden="true">
        <rect
          x="1"
          y="1"
          width="22"
          height="34"
          rx="11"
          fill="none"
          stroke="currentColor"
          stroke-width="1.5"
        ></rect>
        <path d="M12 8v7" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"></path>
      </svg>
    </a>
  </section>

  <!-- Three facts, overlapping the hero -->
  <section id="fakti" class="bg-mist relative flow-root px-5 pb-20 lg:pb-28">
    <dl
      class="bg-night-soft border-gold relative z-10 mx-auto -mt-20 grid max-w-5xl divide-y divide-white/10 rounded-xs border-t-2 text-white shadow-[0_30px_80px_-30px_rgb(0_0_0/0.75)] sm:grid-cols-3 sm:divide-x sm:divide-y-0"
      data-reveal
    >
      <div class="flex flex-col-reverse justify-end px-8 py-8 text-center">
        <dt class="mt-2 text-sm leading-snug text-white/60">{t('stats.fraternities')}</dt>
        <dd class="font-display text-gold text-5xl tabular-nums" data-count={members.length}>
          {members.length}
        </dd>
      </div>
      <div class="flex flex-col-reverse justify-end px-8 py-8 text-center">
        <dt class="mt-2 text-sm leading-snug text-white/60">{t('stats.founded')}</dt>
        <dd class="font-display text-gold text-5xl tabular-nums" data-count={page.foundedYear}>
          {page.foundedYear}
        </dd>
      </div>
      <div class="flex flex-col-reverse justify-end px-8 py-8 text-center">
        <dt class="mt-2 text-sm leading-snug text-white/60">{t('stats.presiding', { term: page.term })}</dt>
        <dd class="font-display text-gold flex items-center justify-center gap-3 text-5xl">
          {presiding.data.name}
          <Shield
            colors={presiding.data.colors}
            band={presiding.data.band}
            className="h-10 w-auto text-white/60"
          />
        </dd>
      </div>
    </dl>
  </section>

  <!-- About -->
  <section class="bg-mist pb-24 lg:pb-32">
    <div class="shell grid items-center gap-14 lg:grid-cols-2 lg:gap-20">
      <div class="relative mx-auto w-full max-w-md lg:max-w-none" data-reveal>
        <span
          class="border-gold/60 absolute inset-0 translate-x-4 translate-y-4 border"
          aria-hidden="true"
        ></span>
        <div class="border-cloud relative border bg-white p-10 sm:p-14">
          <Image
            src={crest}
            alt={copy.crestAlt}
            widths={[360, 560, 800]}
            sizes="(min-width: 64rem) 28rem, 80vw"
            class="mx-auto w-full max-w-sm"
          />
        </div>
      </div>
      <div>
        <p class="kicker" data-reveal>
          {t('about.kicker')}
        </p>
        <Title text={t('about.title')} class="mt-5" />
        <p class="text-slate mt-7 text-lg leading-relaxed" data-reveal>
          {page.lead} {page.intro}
        </p>
        <p class="mt-9" data-reveal>
          <a href="#" class="btn btn-line">
            {t('about.aims')} →
          </a>
        </p>
      </div>
    </div>
  </section>

  <!-- Fraternities -->
  <section id="korporacijas" class="on-night bg-night py-24 text-white lg:py-32">
    <div class="shell">
      <div class="mx-auto max-w-2xl text-center">
        <p class="kicker" data-reveal>
          {t('fraternities.kicker')}
        </p>
        <Title text={t('fraternities.title')} class="mt-5" />
        <p class="mt-5 text-white/65" data-reveal>
          {t('fraternities.intro')}
        </p>
      </div>

      <ol class="mt-14 grid grid-cols-2 gap-3 sm:grid-cols-4 lg:grid-cols-5">
        {members.map((fraternity, i) => (
          <li data-reveal style={`--reveal-order:${i % 5}`}>
            <a
              href="#"
              class="group hover:border-gold/60 flex h-full flex-col items-center rounded-xs border border-white/10 bg-white/[0.03] px-4 py-7 text-center transition duration-300 hover:-translate-y-1 hover:bg-white/[0.07]"
            >
              <Shield
                colors={fraternity.data.colors}
                band={fraternity.data.band}
                className="h-16 w-auto text-white/45 transition-transform duration-500 group-hover:scale-110"
              />
              <h3 class="font-display mt-5 text-lg leading-tight">{fraternity.data.name}</h3>
              <p class="mt-1.5 text-[0.7rem] font-medium tracking-[0.14em] text-white/45 uppercase">
                {t('fraternities.founded', { year: foundedYear(fraternity.data.founded) })}
              </p>
            </a>
          </li>
        ))}
      </ol>

      <p
        class="mt-8 flex flex-wrap items-center justify-center gap-x-8 gap-y-3 text-sm text-white/60"
        data-reveal
      >
        <span class="tracking-[0.2em] uppercase">{t('fraternities.outside')}</span>
        {outside.map((fraternity) => (
          <a href="#" class="hover:text-gold flex items-center gap-2 text-white/85">
            <Shield
              colors={fraternity.data.colors}
              band={fraternity.data.band}
              className="h-6 w-auto text-white/45"
            />
            {fraternity.data.name}
          </a>
        ))}
      </p>

      <p class="mt-12 text-center" data-reveal>
        <a href="#" class="btn btn-ghost">
          {t('fraternities.all')} →
        </a>
      </p>
    </div>
  </section>

  <!-- Officers -->
  <section class="bg-white py-24 lg:py-32">
    <div class="shell">
      <div class="mx-auto max-w-2xl text-center">
        <p class="kicker" data-reveal>
          {t('officers.kicker', { term: page.term })}
        </p>
        <Title text={t('officers.title')} class="mt-5" />
      </div>

      <ul class="mx-auto mt-14 grid max-w-5xl gap-8 sm:grid-cols-3">
        {page.officers.map((officer, i) => (
          <li
            class="group border-cloud overflow-hidden rounded-xs border bg-white shadow-[0_24px_60px_-40px_rgb(12_17_29/0.5)]"
            data-reveal
            style={`--reveal-order:${i}`}
          >
            <div class="aspect-square overflow-hidden">
              <Image
                src={officer.photo}
                alt={`${officer.role}: ${officer.name}`}
                widths={[320, 480, 720]}
                sizes="(min-width: 64rem) 20rem, (min-width: 40rem) 30vw, 100vw"
                class="h-full w-full object-cover transition duration-700 ease-out group-hover:scale-105"
              />
            </div>
            <div class="px-6 pt-6 pb-7 text-center">
              <p class="bg-gold/20 text-gold-deep inline-block rounded-full px-3.5 py-1 text-[0.68rem] font-semibold tracking-[0.18em] uppercase">
                {officer.role}
              </p>
              <h3 class="font-display mt-3.5 text-[1.35rem] leading-tight">
                <span class="text-slate italic">{officer.honorific}</span> {officer.name}
              </h3>
              <a
                href={`mailto:${officer.email}`}
                class="text-slate hover:text-wine mt-2 inline-block text-sm underline-offset-4 hover:underline"
              >
                {officer.email}
              </a>
            </div>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- History -->
  <section class="on-night bg-night relative isolate overflow-hidden py-28 text-white lg:py-40">
    <Image
      src={procession}
      alt=""
      widths={[768, 1280, 2048]}
      sizes="100vw"
      class="absolute inset-0 -z-20 h-full w-full object-cover opacity-45"
    />
    <div class="from-night via-night/85 to-night/30 absolute inset-0 -z-10 bg-linear-to-r"></div>
    <div class="shell">
      <div class="max-w-2xl">
        <p class="kicker" data-reveal>
          {t('history.kicker')}
        </p>
        <Title text={t('history.title')} class="mt-5" />
        <p class="mt-7 text-lg leading-relaxed text-white/80" data-reveal>
          {page.historyTeaser}
        </p>
        <p class="mt-9" data-reveal>
          <a href="#" class="btn btn-gold">
            {t('history.more')} →
          </a>
        </p>
      </div>
    </div>
  </section>

  <!-- Calendar -->
  <section id="kalendars" class="bg-mist py-24 lg:py-32">
    <div class="shell">
      <div class="mx-auto max-w-2xl text-center">
        <p class="kicker" data-reveal>
          {t('calendar.kicker')}
        </p>
        <Title text={t('calendar.title')} class="mt-5" />
      </div>
      <div class="mt-14" data-reveal>
        <MonthCalendar
          client:visible
          events={page.calendar.events}
          colors={page.calendar.colors}
          locale={locale}
          strings={page.strings}
          builtOn={todayInRiga()}
          subscribeUrl={page.calendar.subscribeUrl}
        />
      </div>
    </div>
  </section>

  <!-- Contact -->
  <section
    id="kontakti"
    class="on-night bg-night relative isolate overflow-hidden pt-36 pb-28 text-center text-white"
  >
    <Image
      src={candles}
      alt=""
      widths={[768, 1280, 1706]}
      sizes="100vw"
      class="absolute inset-0 -z-20 h-full w-full object-cover"
    />
    <div class="bg-night/80 absolute inset-0 -z-10"></div>
    <svg
      viewBox="0 0 1440 70"
      preserveAspectRatio="none"
      class="text-mist absolute inset-x-0 -top-px h-12 w-full sm:h-[70px]"
      aria-hidden="true"
    >
      <path d="M0 0h1440v18C1080 78 360 78 0 18z" fill="currentColor"></path>
    </svg>

    <div class="shell">
      <p class="kicker" data-reveal>
        {t('contact.kicker')}
      </p>
      <Title text={t('contact.title')} class="mt-5" />
      <p class="mt-9" data-reveal>
        <a href={`mailto:${page.contact.email}`} class="btn btn-gold break-all">
          {page.contact.email}
        </a>
      </p>
      <address class="mt-10 space-y-1 text-white/70 not-italic" data-reveal>
        <p class="text-white">{page.contact.legalName}</p>
        <p>
          {t('contact.registration')} {page.contact.registrationNumber}
        </p>
        <p>{page.contact.address}</p>
      </address>
    </div>
  </section>
</Layout>
